{% extends 'base.html.twig' %}
{% block title %}Witamy w Wynajmie Aut{% endblock %}

{% block body %}
<style>
    .home-hero {
        background:
            radial-gradient(1100px 550px at 5% -10%, rgba(37, 99, 235, 0.15) 0%, transparent 55%),
            radial-gradient(900px 480px at 100% 10%, rgba(251, 191, 36, 0.14) 0%, transparent 50%),
            linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #fff;
        border-radius: 1.3rem;
        padding: clamp(2rem, 4vw, 3rem);
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.16);
        overflow: hidden;
        position: relative;
    }

    .home-hero-title {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        line-height: 1.08;
        margin-bottom: .75rem;
    }

    .home-hero-subtitle {
        font-size: 1rem;
        color: rgba(255,255,255,.82);
        max-width: 680px;
        margin-bottom: 1.4rem;
    }

    .home-hero-actions .btn {
        border-radius: .95rem;
        font-weight: 700;
        padding: .8rem 1.15rem;
    }

    .home-hero-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .home-stat-box {
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 1rem;
        padding: 1rem;
        backdrop-filter: blur(6px);
    }

    .home-stat-value {
        font-size: 1.35rem;
        font-weight: 800;
        line-height: 1;
        margin-bottom: .25rem;
    }

    .home-stat-label {
        font-size: .85rem;
        color: rgba(255,255,255,.78);
    }

    .home-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin: 2rem 0 1rem;
    }

    .home-section-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0;
    }

    .home-section-subtitle {
        color: #64748b;
        font-size: .92rem;
        margin: .15rem 0 0;
    }

    .home-cars-grid {
        row-gap: 28px;
    }

    .home-car-card {
        border: 0;
        border-radius: 1rem;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
        transition: transform .2s ease, box-shadow .2s ease;
        height: 100%;
    }

    .home-car-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.12);
    }

    .home-car-media {
        position: relative;
        height: 220px;
        background: #f8fafc;
    }

    .home-car-media img,
    .home-no-photo {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .home-no-photo {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #64748b;
        background: linear-gradient(135deg, #f8fafc 0%, #eef2f7 100%);
        font-weight: 500;
    }

    .home-price-badge {
        position: absolute;
        right: 12px;
        bottom: 12px;
        background: rgba(15, 23, 42, 0.82);
        color: #fff;
        padding: .5rem .8rem;
        border-radius: 999px;
        font-weight: 700;
        font-size: .8rem;
        backdrop-filter: blur(6px);
    }

    .home-car-body {
        padding: 1rem;
    }

    .home-car-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 .25rem;
    }

    .home-car-subtle {
        color: #64748b;
        font-size: .87rem;
        margin-bottom: .9rem;
    }

    .home-car-actions .btn {
        border-radius: .85rem;
        font-weight: 600;
    }

    .home-empty-state {
        border: 1px dashed #cbd5e1;
        background: #f8fafc;
        border-radius: 1rem;
        padding: 2rem 1.25rem;
        text-align: center;
    }

    .home-empty-icon {
        font-size: 2.2rem;
        margin-bottom: .55rem;
    }

    .home-feature-row {
        margin-top: 2rem;
    }

    .home-feature-card {
        border: 0;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
        padding: 1.2rem;
        height: 100%;
    }

    .home-feature-icon {
        font-size: 1.5rem;
        margin-bottom: .65rem;
    }

    .home-feature-title {
        font-size: 1rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: .35rem;
    }

    .home-feature-text {
        color: #64748b;
        font-size: .9rem;
        margin: 0;
    }

    @media (max-width: 991px) {
        .home-hero-stats {
            grid-template-columns: 1fr;
        }

        .home-car-media {
            height: 200px;
        }
    }
</style>

<div class="container my-4">
    <section class="home-hero">
        <div class="home-hero-title">🚗 Wynajmij auto szybko i wygodnie</div>
        <div class="home-hero-subtitle">
            Przeglądaj oferty, porównuj ceny i rezerwuj samochód w kilku prostych krokach.
            Intuicyjny system pozwala także właścicielom wygodnie zarządzać swoimi pojazdami.
        </div>

        <div class="home-hero-actions d-flex flex-wrap gap-2">
            <a href="{{ path('app_car_list') }}" class="btn btn-light btn-lg">
                Przeglądaj samochody
            </a>

            {% if app.user %}
                <a href="{{ path('app_reservations') }}" class="btn btn-outline-light btn-lg">
                    Moje rezerwacje
                </a>
            {% else %}
                <a href="{{ path('app_register') }}" class="btn btn-outline-light btn-lg">
                    Załóż konto
                </a>
            {% endif %}
        </div>

        <div class="home-hero-stats">
            <div class="home-stat-box">
                <div class="home-stat-value">{{ cars|slice(0, 6)|length }}</div>
                <div class="home-stat-label">dostępnych ofert na stronie głównej</div>
            </div>

            <div class="home-stat-box">
                <div class="home-stat-value">24/7</div>
                <div class="home-stat-label">dostęp do przeglądania ofert</div>
            </div>

            <div class="home-stat-box">
                <div class="home-stat-value">Prosty</div>
                <div class="home-stat-label">proces rezerwacji i obsługi użytkownika</div>
            </div>
        </div>
    </section>

    <div class="row home-feature-row g-4">
        <div class="col-md-4">
            <div class="home-feature-card">
                <div class="home-feature-icon">🔎</div>
                <div class="home-feature-title">Wygodne wyszukiwanie</div>
                <p class="home-feature-text">
                    Filtruj oferty według marki, modelu, ceny, rocznika i lokalizacji.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="home-feature-card">
                <div class="home-feature-icon">📅</div>
                <div class="home-feature-title">Prosty proces rezerwacji</div>
                <p class="home-feature-text">
                    Wybierz termin, potwierdź dane i śledź status swojej rezerwacji.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="home-feature-card">
                <div class="home-feature-icon">🧾</div>
                <div class="home-feature-title">Dokumenty i historia</div>
                <p class="home-feature-text">
                    Zarządzaj rezerwacjami, umowami, fakturami i historią zmian w jednym miejscu.
                </p>
            </div>
        </div>
    </div>

    <div class="home-section-header">
        <div>
            <h2 class="home-section-title">Polecane samochody</h2>
            <div class="home-section-subtitle">
                Najnowsze i najciekawsze pojazdy dostępne w systemie.
            </div>
        </div>

        <a href="{{ path('app_car_list') }}" class="btn btn-outline-primary">
            Zobacz wszystkie
        </a>
    </div>

    {% if cars is empty %}
        <div class="home-empty-state">
            <div class="home-empty-icon">🧐</div>
            <div class="fw-semibold mb-1">Brak samochodów do wyświetlenia</div>
            <div class="text-muted small">
                Gdy pojawią się nowe oferty, zobaczysz je właśnie tutaj.
            </div>
        </div>
    {% else %}
        <div class="row home-cars-grid">
            {% for car in cars|slice(0, 6) %}
                {% set img = car.mainImage ? asset('uploads/cars/' ~ car.mainImage) : null %}

                <div class="col-12 col-sm-6 col-lg-4 d-flex">
                    <a href="{{ path('app_car_details', {'id': car.id}) }}"
                       class="text-decoration-none text-dark d-block w-100">

                        <div class="home-car-card w-100">
                            <div class="home-car-media">
                                {% if img %}
                                    <img src="{{ img }}" alt="{{ car.brand ~ ' ' ~ car.model }}">
                                {% else %}
                                    <div class="home-no-photo">Brak zdjęcia</div>
                                {% endif %}

                                <span class="home-price-badge">{{ car.pricePerDay }} zł / dzień</span>
                            </div>

                            <div class="home-car-body">
                                <h3 class="home-car-title">{{ car.brand }} {{ car.model }}</h3>
                                <div class="home-car-subtle">
                                    Rok: {{ car.year }}{% if car.location %} • {{ car.location }}{% endif %}
                                </div>

                                <div class="home-car-actions d-grid">
                                    <span class="btn btn-outline-primary disabled">Zobacz szczegóły</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
