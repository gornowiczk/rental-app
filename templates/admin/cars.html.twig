{% extends 'base.html.twig' %}
{% block title %}Auta{% endblock %}

{% block body %}
<style>
    .admin-page-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #fff;
        border-radius: 1rem;
        padding: 1.4rem;
        margin-bottom: 1.5rem;
    }

    .admin-page-title {
        font-size: 1.6rem;
        font-weight: 800;
    }

    .admin-page-subtitle {
        opacity: .8;
        font-size: .92rem;
    }

    .admin-card {
        border: 0;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    }

    .admin-table {
        width: 100%;
        min-width: 1120px;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

    .admin-table thead th {
        font-size: .8rem;
        text-transform: uppercase;
        color: #64748b;
        border: 0;
        background: transparent;
        padding: 0 .8rem;
    }

    .admin-row td {
        background: #fff;
        padding: .9rem;
        border-top: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
    }

    .admin-row td:first-child {
        border-left: 1px solid #e2e8f0;
        border-radius: .8rem 0 0 .8rem;
    }

    .admin-row td:last-child {
        border-right: 1px solid #e2e8f0;
        border-radius: 0 .8rem .8rem 0;
    }

    .admin-main {
        font-weight: 700;
        color: #0f172a;
    }

    .admin-main-link {
        font-weight: 700;
        color: #0f172a;
        text-decoration: none;
    }

    .admin-main-link:hover {
        color: #0d6efd;
        text-decoration: underline;
    }

    .admin-sub {
        font-size: .85rem;
        color: #64748b;
    }

    .badge-soft-success {
        background: #dcfce7;
        color: #166534;
        font-weight: 700;
    }

    .badge-soft-danger {
        background: #fee2e2;
        color: #991b1b;
        font-weight: 700;
    }

    .badge-soft-warning {
        background: #fef3c7;
        color: #92400e;
        font-weight: 700;
    }

    .badge-soft-secondary {
        background: #e2e8f0;
        color: #334155;
        font-weight: 700;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
        justify-content: flex-end;
    }

    .actions .btn {
        border-radius: .7rem;
        font-weight: 600;
    }

    .inline-form {
        display: flex;
        gap: .3rem;
        align-items: center;
    }

    .inline-form input {
        border-radius: .6rem;
    }
</style>

<div class="admin-page-hero">
    <div class="admin-page-title">Auta</div>
    <div class="admin-page-subtitle">
        Zarządzaj pojazdami, ich dostępnością oraz statusem wynajmu.
    </div>
</div>

<div class="admin-card p-3 mb-4">
    <form class="row g-3" method="get">
        <div class="col-md-4">
            <input class="form-control"
                   name="q"
                   placeholder="Szukaj (brand/model/rejestracja/email)"
                   value="{{ filters.q }}">
        </div>

        <div class="col-md-3">
            <select class="form-select" name="city">
                <option value="">-- miasto --</option>
                {% for c in cities %}
                    <option value="{{ c }}" {{ filters.city == c ? 'selected' : '' }}>{{ c }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="col-md-3">
            <select class="form-select" name="state">
                <option value="">-- status --</option>
                <option value="rentable" {{ filters.state == 'rentable' ? 'selected' : '' }}>rentable</option>
                <option value="paused" {{ filters.state == 'paused' ? 'selected' : '' }}>paused</option>
                <option value="off" {{ filters.state == 'off' ? 'selected' : '' }}>off</option>
            </select>
        </div>

        <div class="col-md-2">
            <button class="btn btn-dark w-100">Filtruj</button>
        </div>
    </form>
</div>

<div class="admin-card p-3">
    {% if cars is empty %}
        <div class="text-center text-muted py-4">
            🚗 Brak aut
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Auto</th>
                    <th>Właściciel</th>
                    <th>Miasto</th>
                    <th>Status</th>
                    <th>Wstrzymane do</th>
                    <th class="text-end">Akcje</th>
                </tr>
                </thead>

                <tbody>
                {% for c in cars %}
                    {% set paused = c.pausedUntil and c.pausedUntil > now %}
                    {% set rentable = (c.isAvailable and not paused) %}

                    <tr class="admin-row">
                        <td><div class="admin-main">#{{ c.id }}</div></td>

                        <td>
                            <a class="admin-main-link" href="{{ path('app_car_details', {id: c.id}) }}">
                                {{ c.brand }} {{ c.model }}
                            </a>
                            <div class="admin-sub">
                                {{ c.year }} • {{ c.registrationNumber }} • {{ c.pricePerDay }} zł
                            </div>
                        </td>

                        <td class="admin-sub">
                            {{ c.owner ? c.owner.email : '—' }}
                        </td>

                        <td>{{ c.location ?: '—' }}</td>

                        <td>
                            {% if rentable %}
                                <span class="badge badge-soft-success">rentable</span>
                            {% else %}
                                {% if not c.isAvailable %}
                                    <span class="badge badge-soft-danger">off</span>
                                {% endif %}
                                {% if paused %}
                                    <span class="badge badge-soft-secondary">paused</span>
                                {% endif %}
                                {% if c.isAvailable and not paused %}
                                    <span class="badge badge-soft-warning">not rentable</span>
                                {% endif %}
                            {% endif %}
                        </td>

                        <td>
                            {{ c.pausedUntil ? c.pausedUntil|date('Y-m-d') : '—' }}
                        </td>

                        <td>
                            <div class="actions">
                                <a class="btn btn-sm btn-outline-primary"
                                   href="{{ path('app_car_details', {id: c.id}) }}">
                                    Szczegóły
                                </a>

                                <form method="post" action="{{ path('admin_car_toggle', {id: c.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_car_toggle_' ~ c.id) }}">
                                    <button class="btn btn-sm {{ c.isAvailable ? 'btn-outline-danger' : 'btn-outline-success' }}">
                                        {{ c.isAvailable ? 'Wyłącz' : 'Włącz' }}
                                    </button>
                                </form>

                                <form method="post"
                                      action="{{ path('admin_car_pause', {id: c.id}) }}"
                                      class="inline-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_car_pause_' ~ c.id) }}">
                                    <input type="date" name="pausedUntil" class="form-control form-control-sm">
                                    <button class="btn btn-sm btn-outline-secondary">Wstrzymaj</button>
                                </form>

                                <form method="post" action="{{ path('admin_car_unpause', {id: c.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_car_unpause_' ~ c.id) }}">
                                    <button class="btn btn-sm btn-outline-primary"
                                            {{ c.pausedUntil ? '' : 'disabled' }}>
                                        Wznów
                                    </button>
                                </form>

                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}