{% extends 'base.html.twig' %}
{% block title %}Użytkownik #{{ u.id }}{% endblock %}

{% block body %}
<style>
    .admin-page-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #fff;
        border-radius: 1rem;
        padding: 1.4rem;
        margin-bottom: 1.5rem;
    }

    .admin-page-title {
        font-size: 1.6rem;
        font-weight: 800;
        margin-bottom: .3rem;
    }

    .admin-page-subtitle {
        opacity: .82;
        font-size: .92rem;
    }

    .admin-card,
    .admin-side-card {
        border: 0;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    }

    .admin-section-title {
        font-size: 1.02rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 1rem;
    }

    .admin-meta-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .9rem;
    }

    .admin-meta-item {
        background: #f8fafc;
        border: 1px solid #e9eef5;
        border-radius: .9rem;
        padding: .9rem 1rem;
    }

    .admin-meta-label {
        font-size: .78rem;
        color: #64748b;
        margin-bottom: .18rem;
    }

    .admin-meta-value {
        font-weight: 700;
        color: #0f172a;
        word-break: break-word;
    }

    .admin-role-list {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
    }

    .admin-role-badge {
        border-radius: 999px;
        padding: .35rem .65rem;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: .76rem;
        font-weight: 700;
    }

    .admin-status-badge {
        border-radius: 999px;
        padding: .45rem .75rem;
        font-size: .78rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        white-space: nowrap;
    }

    .admin-status-active {
        background: #dcfce7;
        color: #166534;
    }

    .admin-status-blocked {
        background: #fee2e2;
        color: #991b1b;
    }

    .admin-soft-box {
        background: #f8fafc;
        border: 1px solid #e9eef5;
        border-radius: .95rem;
        padding: 1rem;
    }

    .admin-list-item + .admin-list-item {
        border-top: 1px solid #eef2f7;
        margin-top: 1rem;
        padding-top: 1rem;
    }

    .admin-item-title {
        font-weight: 700;
        color: #0f172a;
        margin-bottom: .2rem;
    }

    .admin-item-subtitle {
        color: #64748b;
        font-size: .88rem;
    }

    .admin-actions .btn {
        border-radius: .8rem;
        font-weight: 600;
    }

    .admin-empty {
        border: 1px dashed #cbd5e1;
        background: #f8fafc;
        border-radius: 1rem;
        padding: 2rem 1.25rem;
        text-align: center;
    }

    .admin-stat-box {
        background: linear-gradient(135deg, #0d6efd 0%, #2563eb 100%);
        color: #fff;
        border-radius: 1rem;
        padding: 1rem 1.1rem;
    }

    .admin-stat-big {
        font-size: 1.5rem;
        font-weight: 800;
        line-height: 1;
    }

    .admin-link-clean {
        text-decoration: none;
        color: inherit;
    }

    .admin-link-clean:hover .admin-item-title {
        color: #0d6efd;
    }

    @media (max-width: 991px) {
        .admin-meta-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

{% set fullName = ((u.firstName|default('') ~ ' ' ~ u.lastName|default(''))|trim) %}
{% set fullName = fullName ?: 'Brak danych' %}

<div class="admin-page-hero">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <div class="admin-page-title">Użytkownik #{{ u.id }}</div>
            <div class="admin-page-subtitle">
                {{ u.email }}
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            {% if u.isBlocked %}
                <span class="admin-status-badge admin-status-blocked">● blocked</span>
            {% else %}
                <span class="admin-status-badge admin-status-active">● active</span>
            {% endif %}

            <a class="btn btn-light fw-semibold" href="{{ path('admin_users') }}">
                ← Wróć
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="admin-card p-3 p-md-4 mb-4">
            <div class="admin-section-title">Dane użytkownika</div>

            <div class="admin-meta-grid mb-4">
                <div class="admin-meta-item">
                    <div class="admin-meta-label">ID</div>
                    <div class="admin-meta-value">#{{ u.id }}</div>
                </div>

                <div class="admin-meta-item">
                    <div class="admin-meta-label">Email</div>
                    <div class="admin-meta-value">{{ u.email }}</div>
                </div>

                <div class="admin-meta-item">
                    <div class="admin-meta-label">Imię i nazwisko</div>
                    <div class="admin-meta-value">{{ fullName }}</div>
                </div>

                <div class="admin-meta-item">
                    <div class="admin-meta-label">Telefon</div>
                    <div class="admin-meta-value">{{ u.phoneNumber|default('Nie podano') }}</div>
                </div>

                <div class="admin-meta-item">
                    <div class="admin-meta-label">Adres</div>
                    <div class="admin-meta-value">{{ u.address|default('Nie podano') }}</div>
                </div>

                <div class="admin-meta-item">
                    <div class="admin-meta-label">PESEL / NIP</div>
                    <div class="admin-meta-value">{{ u.peselOrNip|default('Nie podano') }}</div>
                </div>
            </div>

            <div class="admin-section-title">Role</div>
            <div class="admin-soft-box">
                <div class="admin-role-list">
                    {% for role in u.roles %}
                        <span class="admin-role-badge">{{ role }}</span>
                    {% endfor %}
                </div>
            </div>

            {% if u.isBlocked %}
                <div class="admin-section-title mt-4">Informacje o blokadzie</div>
                <div class="admin-soft-box">
                    <div><strong>Data blokady:</strong> {{ u.blockedAt ? u.blockedAt|date('Y-m-d H:i') : '—' }}</div>
                    <div><strong>Powód:</strong> {{ u.blockedReason ?: '—' }}</div>
                </div>
            {% endif %}
        </div>

        <div class="admin-card p-3 p-md-4 mb-4">
            <div class="admin-section-title">Rezerwacje użytkownika</div>

            {% if userReservations is empty %}
                <div class="admin-empty">
                    <div class="fw-semibold mb-1">Brak rezerwacji</div>
                    <div class="text-muted small">Ten użytkownik nie ma jeszcze żadnych rezerwacji.</div>
                </div>
            {% else %}
                {% for r in userReservations %}
                    <a href="{{ path('admin_reservation_show', {id: r.id}) }}" class="admin-link-clean">
                        <div class="admin-list-item">
                            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                                <div>
                                    <div class="admin-item-title">
                                        Rezerwacja #{{ r.id }} — {{ r.car.brand }} {{ r.car.model }}
                                    </div>
                                    <div class="admin-item-subtitle">
                                        {{ r.startDate|date('Y-m-d') }} → {{ r.endDate|date('Y-m-d') }} • {{ r.status }}
                                    </div>
                                </div>

                                <div>
                                    <span class="btn btn-sm btn-outline-primary">Szczegóły</span>
                                </div>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            {% endif %}
        </div>

        <div class="admin-card p-3 p-md-4">
            <div class="admin-section-title">Auta użytkownika</div>

            {% if ownedCars is empty %}
                <div class="admin-empty">
                    <div class="fw-semibold mb-1">Brak aut</div>
                    <div class="text-muted small">Ten użytkownik nie ma dodanych pojazdów.</div>
                </div>
            {% else %}
                {% for car in ownedCars %}
                    <a href="{{ path('app_car_details', {id: car.id}) }}" class="admin-link-clean">
                        <div class="admin-list-item">
                            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                                <div>
                                    <div class="admin-item-title">
                                        {{ car.brand }} {{ car.model }}
                                    </div>
                                    <div class="admin-item-subtitle">
                                        {{ car.registrationNumber }} • {{ car.year }} • {{ car.pricePerDay }} zł / dzień
                                    </div>
                                </div>

                                <div>
                                    <span class="btn btn-sm btn-outline-primary">Szczegóły</span>
                                </div>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            {% endif %}
        </div>
    </div>

    <div class="col-lg-4">
        <div class="admin-side-card p-3 p-md-4 sticky-top" style="top: 90px;">
            <div class="admin-stat-box mb-4">
                <div class="small opacity-75 mb-1">Podsumowanie</div>
                <div class="admin-stat-big">{{ u.email }}</div>
                <div class="small opacity-75 mt-2">
                    Rezerwacje: {{ userReservations|length }} • Auta: {{ ownedCars|length }}
                </div>
            </div>

            <div class="admin-section-title">Akcje</div>
            <div class="admin-actions d-grid gap-2">
                {% if u.isBlocked %}
                    <form method="post" action="{{ path('admin_unblock_user', {id: u.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_unblock_user_' ~ u.id) }}">
                        <button class="btn btn-outline-success w-100">Odblokuj</button>
                    </form>
                {% else %}
                    <form method="post" action="{{ path('admin_block_user', {id: u.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_block_user_' ~ u.id) }}">
                        <input type="text" name="reason" class="form-control mb-2" placeholder="Powód blokady">
                        <button class="btn btn-outline-danger w-100">Zablokuj</button>
                    </form>
                {% endif %}

                {% if is_granted('ROLE_SUPER_ADMIN') %}
                    <form method="post" action="{{ path('admin_toggle_manager', {id: u.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_toggle_manager_' ~ u.id) }}">
                        <button class="btn btn-outline-primary w-100">Toggle MANAGER</button>
                    </form>

                    <form method="post" action="{{ path('admin_toggle_admin', {id: u.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_toggle_admin_' ~ u.id) }}">
                        <button class="btn btn-outline-primary w-100">Toggle ADMIN</button>
                    </form>

                    <form method="post" action="{{ path('admin_delete_user', {id: u.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_delete_user_' ~ u.id) }}">
                        <button class="btn btn-danger w-100"
                                onclick="return confirm('Na pewno usunąć konto?')">
                            Usuń użytkownika
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}