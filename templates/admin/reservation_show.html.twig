{% extends 'base.html.twig' %}
{% block title %}Rezerwacja #{{ r.id }}{% endblock %}

{% block body %}
<style>
    .admin-page-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #fff;
        border-radius: 1rem;
        padding: 1.4rem;
        margin-bottom: 1.5rem;
    }

    .admin-page-title {
        font-size: 1.6rem;
        font-weight: 800;
        margin-bottom: .3rem;
    }

    .admin-page-subtitle {
        opacity: .82;
        font-size: .92rem;
    }

    .admin-card,
    .admin-side-card {
        border: 0;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    }

    .admin-section-title {
        font-size: 1.02rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 1rem;
    }

    .admin-meta-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .9rem;
    }

    .admin-meta-item {
        background: #f8fafc;
        border: 1px solid #e9eef5;
        border-radius: .9rem;
        padding: .9rem 1rem;
    }

    .admin-meta-label {
        font-size: .78rem;
        color: #64748b;
        margin-bottom: .18rem;
    }

    .admin-meta-value {
        font-weight: 700;
        color: #0f172a;
        word-break: break-word;
    }

    .admin-soft-box {
        background: #f8fafc;
        border: 1px solid #e9eef5;
        border-radius: .95rem;
        padding: 1rem;
    }

    .admin-status-badge {
        border-radius: 999px;
        padding: .48rem .8rem;
        font-size: .78rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        white-space: nowrap;
        text-transform: capitalize;
    }

    .admin-status-pending {
        background: #fff3cd;
        color: #7c5a00;
    }

    .admin-status-accepted {
        background: #dcfce7;
        color: #166534;
    }

    .admin-status-rejected {
        background: #fee2e2;
        color: #991b1b;
    }

    .admin-status-cancelled {
        background: #f1f5f9;
        color: #475569;
    }

    .admin-status-completed {
        background: #e2e8f0;
        color: #334155;
    }

    .admin-invoice-yes {
        background: #dcfce7;
        color: #166534;
        border-radius: 999px;
        padding: .35rem .65rem;
        font-size: .75rem;
        font-weight: 700;
        display: inline-block;
    }

    .admin-invoice-no {
        background: #e2e8f0;
        color: #334155;
        border-radius: 999px;
        padding: .35rem .65rem;
        font-size: .75rem;
        font-weight: 700;
        display: inline-block;
    }

    .admin-actions .btn,
    .admin-side-card .btn,
    .admin-side-card .form-select {
        border-radius: .8rem;
        font-weight: 600;
    }

    .admin-side-card .form-control,
    .admin-side-card .form-select {
        border-color: #dbe4ee;
        min-height: 44px;
    }

    .admin-side-card .form-control:focus,
    .admin-side-card .form-select:focus {
        border-color: #93c5fd;
        box-shadow: 0 0 0 .2rem rgba(37, 99, 235, 0.12);
    }

    .admin-price-box {
        background: linear-gradient(135deg, #0d6efd 0%, #2563eb 100%);
        color: #fff;
        border-radius: 1rem;
        padding: 1rem 1.1rem;
    }

    .admin-price-big {
        font-size: 1.55rem;
        font-weight: 800;
        line-height: 1;
        text-transform: capitalize;
    }

    @media (max-width: 991px) {
        .admin-meta-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

{% set statusLabels = {
    'pending': 'Oczekująca',
    'accepted': 'Zaakceptowana',
    'rejected': 'Odrzucona',
    'cancelled': 'Anulowana',
    'completed': 'Zakończona'
} %}

{% set statusClass =
    r.status == 'pending' ? 'admin-status-pending'
    : (r.status == 'accepted' ? 'admin-status-accepted'
    : (r.status == 'rejected' ? 'admin-status-rejected'
    : (r.status == 'cancelled' ? 'admin-status-cancelled'
    : 'admin-status-completed')))
%}

<div class="admin-page-hero">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <div class="admin-page-title">Rezerwacja #{{ r.id }}</div>
            <div class="admin-page-subtitle">
                Utworzona: {{ r.createdAt|date('Y-m-d H:i') }}
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="admin-status-badge {{ statusClass }}">
                {{ statusLabels[r.status]|default(r.status) }}
            </span>

            <a class="btn btn-light fw-semibold" href="{{ path('admin_reservations') }}">
                ← Wróć
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="admin-card p-3 p-md-4 mb-4">
            <div class="admin-section-title">Podstawowe informacje</div>

            <div class="admin-meta-grid mb-4">
                <div class="admin-meta-item">
                    <div class="admin-meta-label">Status</div>
                    <div class="admin-meta-value">{{ statusLabels[r.status]|default(r.status) }}</div>
                </div>

                <div class="admin-meta-item">
                    <div class="admin-meta-label">Daty</div>
                    <div class="admin-meta-value">
                        {{ r.startDate|date('Y-m-d') }} → {{ r.endDate|date('Y-m-d') }}
                    </div>
                </div>

                <div class="admin-meta-item">
                    <div class="admin-meta-label">Auto</div>
                    <div class="admin-meta-value">
                        {{ r.car.brand }} {{ r.car.model }} ({{ r.car.year }})
                    </div>
                </div>

                <div class="admin-meta-item">
                    <div class="admin-meta-label">Klient</div>
                    <div class="admin-meta-value">
                        <a href="{{ path('admin_user_show', {id: r.user.id}) }}" class="text-decoration-none">
                            {{ r.user.email }}
                        </a>
                    </div>
                </div>
            </div>

            <div class="admin-section-title">Kontakt i odbiór</div>
            <div class="admin-meta-grid mb-4">
                <div class="admin-meta-item">
                    <div class="admin-meta-label">Telefon</div>
                    <div class="admin-meta-value">{{ r.phoneNumber ?: '—' }}</div>
                </div>

                <div class="admin-meta-item">
                    <div class="admin-meta-label">Miejsce odbioru</div>
                    <div class="admin-meta-value">{{ r.rentalLocation ?: '—' }}</div>
                </div>
            </div>

            <div class="admin-section-title">Komentarz</div>
            <div class="admin-soft-box">
                {{ r.comment ?: '—' }}
            </div>
        </div>

        <div class="admin-card p-3 p-md-4">
            <div class="admin-section-title">Historia statusów</div>
            {% include '_partials/_reservation_status_log.html.twig' with { logs: logs|default([]) } %}
        </div>
    </div>

    <div class="col-lg-5">
        <div class="admin-side-card p-3 p-md-4 mb-4 sticky-top" style="top: 90px;">
            <div class="admin-price-box mb-4">
                <div class="small opacity-75 mb-1">Status rezerwacji</div>
                <div class="admin-price-big">{{ statusLabels[r.status]|default(r.status) }}</div>
                <div class="small opacity-75 mt-2">
                    {{ r.startDate|date('Y-m-d') }} → {{ r.endDate|date('Y-m-d') }}
                </div>
            </div>

            <div class="admin-section-title">Dokumenty</div>

            {% if r.status in ['accepted','completed'] %}
                <div class="d-grid gap-2 mb-4">
                    <a class="btn btn-outline-primary"
                       href="{{ path('app_contract_generate', {'id': r.id}) }}">
                        📑 Pobierz umowę (PDF)
                    </a>

                    {% if r.status == 'completed' and r.wantsInvoice %}
                        <a class="btn btn-outline-success"
                        href="{{ path('app_invoice_generate', {'id': r.id}) }}">
                            💰 Pobierz fakturę (PDF)
                        </a>
                    {% elseif r.status == 'accepted' and r.wantsInvoice %}
                        <button class="btn btn-outline-success" disabled>
                            💰 Faktura po zakończeniu
                        </button>
                    {% else %}
                        <button class="btn btn-outline-success" disabled>
                            💰 Faktura: NIE WYBRANO
                        </button>
                    {% endif %}
                </div>
            {% elseif r.status in ['rejected','cancelled'] %}
                <div class="alert alert-warning mb-4">
                    Dokumenty niedostępne dla rezerwacji odrzuconej lub anulowanej.
                </div>
            {% else %}
                <div class="alert alert-info mb-4">
                    Dokumenty będą dostępne po akceptacji rezerwacji.
                </div>
            {% endif %}

            <div class="admin-section-title">Zmień status</div>

            <form method="post" action="{{ path('admin_reservation_set_status', {id: r.id}) }}" class="mb-4">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_reservation_set_status_' ~ r.id) }}">

                <select class="form-select mb-2" name="status" required>
                    {% for st in ['pending','accepted','rejected','cancelled','completed'] %}
                        <option value="{{ st }}" {{ r.status == st ? 'selected' : '' }}>
                            {{ statusLabels[st]|default(st) }}
                        </option>
                    {% endfor %}
                </select>

                <button class="btn btn-primary w-100">Zapisz status</button>
            </form>

            {% if is_granted('ROLE_SUPER_ADMIN') %}
                <div class="admin-section-title">Usuwanie</div>

                <div class="admin-actions d-grid gap-2 mb-4">
                    <form method="post"
                          action="{{ path('admin_delete_reservation', {'id': r.id}) }}"
                          onsubmit="return confirm('Czy na pewno usunąć tę rezerwację?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_delete_reservation_' ~ r.id) }}">
                        <button class="btn btn-outline-danger w-100">
                            Usuń rezerwację
                        </button>
                    </form>
                </div>
            {% endif %}

            <div class="admin-section-title">Faktura</div>

            <div class="admin-soft-box">
                <div class="mb-3">
                    <strong>Chce fakturę:</strong>
                    {% if r.wantsInvoice %}
                        <span class="admin-invoice-yes">TAK</span>
                    {% else %}
                        <span class="admin-invoice-no">NIE</span>
                    {% endif %}
                </div>

                {% if r.wantsInvoice %}
                    <div class="mb-1"><strong>Nazwa:</strong> {{ r.invoiceName ?: '—' }}</div>
                    <div class="mb-1"><strong>Adres:</strong> {{ r.invoiceAddress ?: '—' }}</div>
                    <div class="mb-1"><strong>NIP:</strong> {{ r.invoiceNip ?: '—' }}</div>
                {% else %}
                    <div class="text-muted">Brak danych do faktury.</div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}