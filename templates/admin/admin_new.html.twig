{% extends 'base.html.twig' %}
{% block title %}Dodaj admina{% endblock %}

{% block body %}
<style>
    .admin-page-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #fff;
        border-radius: 1rem;
        padding: 1.4rem;
        margin-bottom: 1.5rem;
    }

    .admin-page-title {
        font-size: 1.6rem;
        font-weight: 800;
        margin-bottom: .3rem;
    }

    .admin-page-subtitle {
        opacity: .82;
        font-size: .92rem;
    }

    .admin-card,
    .admin-side-card {
        border: 0;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    }

    .admin-section-title {
        font-size: 1.02rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 1rem;
    }

    .admin-card .form-control,
    .admin-card .form-select {
        border-radius: .8rem;
        border-color: #dbe4ee;
        min-height: 46px;
    }

    .admin-card .form-control:focus,
    .admin-card .form-select:focus {
        border-color: #93c5fd;
        box-shadow: 0 0 0 .2rem rgba(37, 99, 235, 0.12);
    }

    .admin-card .form-label {
        font-weight: 600;
        color: #334155;
        margin-bottom: .45rem;
    }

    .admin-soft-box {
        background: #f8fafc;
        border: 1px solid #e9eef5;
        border-radius: .95rem;
        padding: 1rem;
    }

    .admin-role-info {
        display: grid;
        gap: .75rem;
    }

    .admin-role-box {
        background: #fff;
        border: 1px solid #e9eef5;
        border-radius: .9rem;
        padding: .9rem 1rem;
    }

    .admin-role-title {
        font-weight: 700;
        color: #0f172a;
        margin-bottom: .2rem;
    }

    .admin-role-text {
        color: #64748b;
        font-size: .88rem;
        margin: 0;
    }

    .admin-actions .btn {
        border-radius: .8rem;
        font-weight: 600;
    }

    .admin-side-highlight {
        background: linear-gradient(135deg, #0d6efd 0%, #2563eb 100%);
        color: #fff;
        border-radius: 1rem;
        padding: 1rem 1.1rem;
    }

    .admin-side-highlight-title {
        font-size: 1.4rem;
        font-weight: 800;
        line-height: 1;
    }

    @media (max-width: 991px) {
        .admin-side-card {
            position: static !important;
        }
    }
</style>

<div class="admin-page-hero">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <div class="admin-page-title">Dodaj / ustaw admina</div>
            <div class="admin-page-subtitle">
                Utwórz nowe konto administracyjne i przypisz odpowiedni poziom uprawnień.
            </div>
        </div>

        <a class="btn btn-light fw-semibold" href="{{ path('admin_users') }}">
            ← Wróć do użytkowników
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="admin-card p-3 p-md-4">
            <div class="admin-section-title">Dane konta administratora</div>

            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_create_admin') }}">

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control" type="email" name="email" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Hasło</label>
                    <input class="form-control" type="password" name="password" required>
                </div>

                <div class="mb-4">
                    <label class="form-label">Typ admina</label>
                    <select class="form-select" name="role">
                        <option value="ROLE_ADMIN">ADMIN (podstawowy)</option>
                        <option value="ROLE_MANAGER">MANAGER (niższy poziom)</option>
                        <option value="ROLE_SUPER_ADMIN">SUPER_ADMIN (pełne uprawnienia)</option>
                    </select>
                    <div class="form-text mt-2">
                        SUPER_ADMIN może zarządzać innymi adminami i wykonywać najbardziej wrażliwe operacje.
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 admin-actions">
                    <button class="btn btn-primary px-4">Zapisz</button>
                    <a class="btn btn-outline-secondary px-4" href="{{ path('admin_users') }}">Anuluj</a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="admin-side-card p-3 p-md-4 sticky-top" style="top: 90px;">
            <div class="admin-side-highlight mb-4">
                <div class="small opacity-75 mb-1">Tworzenie konta</div>
                <div class="admin-side-highlight-title">Nowy administrator</div>
                <div class="small opacity-75 mt-2">
                    Wybierz poziom uprawnień zgodnie z zakresem odpowiedzialności danej osoby.
                </div>
            </div>

            <div class="admin-section-title">Poziomy ról</div>

            <div class="admin-role-info">
                <div class="admin-role-box">
                    <div class="admin-role-title">ROLE_MANAGER</div>
                    <p class="admin-role-text">
                        Ograniczone uprawnienia administracyjne do podstawowej obsługi systemu.
                    </p>
                </div>

                <div class="admin-role-box">
                    <div class="admin-role-title">ROLE_ADMIN</div>
                    <p class="admin-role-text">
                        Standardowy administrator z dostępem do głównych sekcji panelu.
                    </p>
                </div>

                <div class="admin-role-box">
                    <div class="admin-role-title">ROLE_SUPER_ADMIN</div>
                    <p class="admin-role-text">
                        Pełna kontrola nad systemem, użytkownikami oraz kontami administratorów.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}