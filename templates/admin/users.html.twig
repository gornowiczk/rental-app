{% extends 'base.html.twig' %}
{% block title %}Użytkownicy{% endblock %}

{% block body %}
<style>
    .admin-page-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #fff;
        border-radius: 1rem;
        padding: 1.4rem;
        margin-bottom: 1.5rem;
    }

    .admin-page-title {
        font-size: 1.6rem;
        font-weight: 800;
        margin-bottom: .3rem;
    }

    .admin-page-subtitle {
        opacity: .82;
        font-size: .92rem;
    }

    .admin-users-card,
    .admin-users-filter-card {
        border: 0;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    }

    .admin-users-section-title {
        font-size: 1.02rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 1rem;
    }

    .admin-users-filter-card .form-control,
    .admin-users-filter-card .form-select {
        border-radius: .8rem;
        border-color: #dbe4ee;
        min-height: 44px;
    }

    .admin-users-filter-card .form-control:focus,
    .admin-users-filter-card .form-select:focus {
        border-color: #93c5fd;
        box-shadow: 0 0 0 .2rem rgba(37, 99, 235, 0.12);
    }

    .admin-users-table-wrap {
        overflow-x: auto;
    }

    .admin-users-table {
        width: 100%;
        min-width: 980px;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

    .admin-users-table thead th {
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #64748b;
        border: 0 !important;
        background: transparent !important;
        padding: 0 .9rem .2rem;
        white-space: nowrap;
    }

    .admin-users-row td {
        background: #fff;
        border-top: 1px solid #e9eef5;
        border-bottom: 1px solid #e9eef5;
        padding: 1rem .9rem;
        vertical-align: top;
    }

    .admin-users-row td:first-child {
        border-left: 1px solid #e9eef5;
        border-top-left-radius: .95rem;
        border-bottom-left-radius: .95rem;
    }

    .admin-users-row td:last-child {
        border-right: 1px solid #e9eef5;
        border-top-right-radius: .95rem;
        border-bottom-right-radius: .95rem;
    }

    .admin-user-main {
        font-weight: 700;
        color: #0f172a;
    }

    .admin-user-sub {
        color: #64748b;
        font-size: .86rem;
        margin-top: .2rem;
    }

    .admin-role-list {
        display: flex;
        flex-wrap: wrap;
        gap: .35rem;
    }

    .admin-role-badge {
        border-radius: 999px;
        padding: .35rem .65rem;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: .76rem;
        font-weight: 700;
    }

    .admin-status-badge {
        border-radius: 999px;
        padding: .45rem .75rem;
        font-size: .78rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        white-space: nowrap;
    }

    .admin-status-active {
        background: #dcfce7;
        color: #166534;
    }

    .admin-status-blocked {
        background: #fee2e2;
        color: #991b1b;
    }

    .admin-users-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        justify-content: flex-end;
    }

    .admin-users-actions .btn {
        border-radius: .75rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .admin-inline-form {
        display: flex;
        gap: .4rem;
        align-items: center;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .admin-inline-form .form-control {
        min-width: 190px;
        border-radius: .75rem;
    }

    .admin-empty {
        border: 1px dashed #cbd5e1;
        background: #f8fafc;
        border-radius: 1rem;
        padding: 2rem 1.25rem;
        text-align: center;
    }

    .admin-empty-icon {
        font-size: 2rem;
        margin-bottom: .55rem;
    }
</style>

<div class="admin-page-hero">
    <div class="admin-page-title">Użytkownicy</div>
    <div class="admin-page-subtitle">
        Zarządzaj kontami, rolami, blokadami oraz uprawnieniami użytkowników systemu.
    </div>
</div>

<div class="admin-users-filter-card p-3 p-md-4 mb-4">
    <div class="admin-users-section-title">Filtry</div>

    <form class="row g-3" method="get">
        <div class="col-md-4">
            <input
                class="form-control"
                name="q"
                placeholder="Szukaj (email / imię / nazwisko)"
                value="{{ filters.q|default('') }}"
            >
        </div>

        <div class="col-md-3">
            <select class="form-select" name="role">
                <option value="">-- rola (wszystkie) --</option>
                <option value="ROLE_ADMIN" {{ filters.role == 'ROLE_ADMIN' ? 'selected' : '' }}>ROLE_ADMIN</option>
                <option value="ROLE_MANAGER" {{ filters.role == 'ROLE_MANAGER' ? 'selected' : '' }}>ROLE_MANAGER</option>
                <option value="ROLE_SUPER_ADMIN" {{ filters.role == 'ROLE_SUPER_ADMIN' ? 'selected' : '' }}>ROLE_SUPER_ADMIN</option>
            </select>
        </div>

        <div class="col-md-3">
            <select class="form-select" name="blocked">
                <option value="">-- blokada (wszystkie) --</option>
                <option value="1" {{ filters.blocked == '1' ? 'selected' : '' }}>zablokowani</option>
                <option value="0" {{ filters.blocked == '0' ? 'selected' : '' }}>niezablokowani</option>
            </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button class="btn btn-dark w-100">Filtruj</button>
        </div>
    </form>
</div>

<div class="admin-users-card p-3 p-md-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div class="admin-users-section-title mb-0">Lista użytkowników</div>
        <span class="badge rounded-pill text-bg-light">{{ users|length }}</span>
    </div>

    {% if users is empty %}
        <div class="admin-empty">
            <div class="admin-empty-icon">👥</div>
            <div class="fw-semibold mb-1">Brak użytkowników</div>
            <div class="text-muted small">Nie znaleziono kont spełniających wybrane kryteria.</div>
        </div>
    {% else %}
        <div class="admin-users-table-wrap">
            <table class="admin-users-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email / Konto</th>
                        <th>Imię i nazwisko</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Blokada</th>
                        <th class="text-end">Akcje</th>
                    </tr>
                </thead>

                <tbody>
                    {% for u in users %}
                        <tr class="admin-users-row">
                            <td>
                                <div class="admin-user-main">#{{ u.id }}</div>
                            </td>

                            <td>
                                <div class="admin-user-main">
                                    <a href="{{ path('admin_user_show', {id: u.id}) }}" class="text-decoration-none">
                                        {{ u.email }}
                                    </a>
                                </div>
                                <div class="admin-user-sub">
                                    {% if u.phoneNumber is defined and u.phoneNumber %}
                                        tel. {{ u.phoneNumber }}
                                    {% else %}
                                        konto użytkownika
                                    {% endif %}
                                </div>
                            </td>

                            <td>
                                <div class="admin-user-main">
                                    {{ u.firstName ?: '' }} {{ u.lastName ?: '' }}
                                </div>
                                <div class="admin-user-sub">
                                    {% if (u.firstName ?: '') == '' and (u.lastName ?: '') == '' %}
                                        Brak danych osobowych
                                    {% else %}
                                        dane podstawowe
                                    {% endif %}
                                </div>
                            </td>

                            <td>
                                <div class="admin-role-list">
                                    {% for role in u.roles %}
                                        <span class="admin-role-badge">{{ role }}</span>
                                    {% endfor %}
                                </div>
                            </td>

                            <td>
                                {% if u.isBlocked %}
                                    <span class="admin-status-badge admin-status-blocked">● blocked</span>
                                {% else %}
                                    <span class="admin-status-badge admin-status-active">● active</span>
                                {% endif %}
                            </td>

                            <td>
                                {% if u.isBlocked %}
                                    <div class="admin-user-main">
                                        {{ u.blockedAt ? u.blockedAt|date('Y-m-d H:i') : '—' }}
                                    </div>
                                    <div class="admin-user-sub">
                                        {{ u.blockedReason ?: 'Brak powodu blokady' }}
                                    </div>
                                {% else %}
                                    <div class="admin-user-sub">—</div>
                                {% endif %}
                            </td>

                            <td>
                                <div class="admin-users-actions">
                                    {% if u.isBlocked %}
                                        <form method="post" action="{{ path('admin_unblock_user', {id: u.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_unblock_user_' ~ u.id) }}">
                                            <button class="btn btn-sm btn-outline-success">Odblokuj</button>
                                        </form>
                                    {% else %}
                                        <form method="post" action="{{ path('admin_block_user', {id: u.id}) }}" class="admin-inline-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_block_user_' ~ u.id) }}">
                                            <input
                                                type="text"
                                                name="reason"
                                                class="form-control form-control-sm"
                                                placeholder="Powód blokady"
                                            >
                                            <button class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Zablokować użytkownika?')">
                                                Zablokuj
                                            </button>
                                        </form>
                                    {% endif %}

                                    {% if is_granted('ROLE_SUPER_ADMIN') %}
                                        <form method="post" action="{{ path('admin_toggle_manager', {id: u.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_toggle_manager_' ~ u.id) }}">
                                            <button class="btn btn-sm btn-outline-primary">Toggle MANAGER</button>
                                        </form>

                                        <form method="post" action="{{ path('admin_toggle_admin', {id: u.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_toggle_admin_' ~ u.id) }}">
                                            <button class="btn btn-sm btn-outline-primary">Toggle ADMIN</button>
                                        </form>

                                        <form method="post" action="{{ path('admin_delete_user', {id: u.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_delete_user_' ~ u.id) }}">
                                            <button class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Na pewno usunąć konto?')">
                                                Usuń
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}