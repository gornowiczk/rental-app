{# templates/pdf/base_pdf.html.twig #}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <style>
        @page { size: A4; margin: 18mm; }

        body {
            font-family: "DejaVu Sans", sans-serif;
            font-size: 12px;
            color: #111;
        }

        h1 { text-align: center; font-size: 20px; margin: 0 0 12px; letter-spacing: .4px; }
        h2 { font-size: 14px; margin: 14px 0 8px; }

        .muted { color: #666; font-size: 11px; }
        .row { width: 100%; margin-top: 10px; }
        .col { width: 49%; display: inline-block; vertical-align: top; }
        .col.right { text-align: right; }

        .box {
            border: 1px solid #222;
            padding: 10px 12px;
            margin: 10px 0;
            border-radius: 3px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
        }

        th, td {
            border: 1px solid #222;
            padding: 7px;
            text-align: left;
        }

        th { background: #f3f3f3; }

        .right { text-align: right; }
        .center { text-align: center; }

        .sign-wrap { margin-top: 40px; }
        .sign {
            width: 45%;
            display: inline-block;
            text-align: center;
            vertical-align: top;
        }
        .line { margin: 28px 0 6px; border-top: 1px solid #222; }
    </style>
</head>
<body>
{% block body %}{% endblock %}
</body>
</html>
