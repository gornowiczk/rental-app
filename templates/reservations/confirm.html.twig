{% extends 'base.html.twig' %}
{% block title %}Potwierdzenie rezerwacji{% endblock %}

{% block body %}
{% set days = ((date(endDate).format('U') - date(startDate).format('U')) / 86400) %}
{% set days = days < 1 ? 1 : days %}
{% set total = days * car.pricePerDay %}

<style>
    .page-shell {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .page-hero {
        background:
            radial-gradient(1000px 500px at 0% 0%, rgba(59,130,246,.18), transparent 55%),
            radial-gradient(800px 400px at 100% 0%, rgba(255,255,255,.08), transparent 40%),
            linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #fff;
        border-radius: 24px;
        padding: clamp(24px, 4vw, 34px);
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.18);
    }

    .page-hero-title {
        font-size: clamp(1.55rem, 2.5vw, 2rem);
        font-weight: 800;
        margin-bottom: .35rem;
        letter-spacing: -.02em;
    }

    .page-hero-subtitle {
        opacity: .86;
        font-size: .98rem;
        max-width: 760px;
    }

    .page-card {
        background: #fff;
        border: 1px solid #e8eef5;
        border-radius: 22px;
        box-shadow: 0 12px 34px rgba(15, 23, 42, 0.08);
        padding: 1.25rem;
        overflow: hidden;
    }

    .summary-card {
        background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
        border: 1px solid #e8eef5;
        border-radius: 20px;
        padding: 1.1rem;
        box-shadow: 0 6px 20px rgba(15, 23, 42, 0.04);
    }

    .section-title {
        font-size: 1.02rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: .2rem;
        letter-spacing: -.01em;
    }

    .section-subtitle {
        color: #64748b;
        font-size: .89rem;
        margin-bottom: 1rem;
    }

    .car-box {
        background: #f8fbff;
        border: 1px solid #dfe9f3;
        border-radius: 18px;
        padding: 1rem;
    }

    .car-name {
        font-size: 1.12rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: .25rem;
    }

    .car-meta {
        color: #64748b;
        font-size: .9rem;
    }

    .badge-row {
        display: flex;
        flex-wrap: wrap;
        gap: .55rem;
        margin-top: .8rem;
    }

    .soft-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        background: #f8fbff;
        border: 1px solid #dfe9f3;
        color: #334155;
        border-radius: 999px;
        padding: .55rem .85rem;
        font-size: .84rem;
        font-weight: 700;
    }

    .green-badge {
        background: #dcfce7;
        border: 1px solid #bbf7d0;
        color: #166534;
    }

    .form-section {
        margin-top: 1.25rem;
    }

    .invoice-box,
    .agree-box {
        background: #f8fbff;
        border: 1px solid #dfe9f3;
        border-radius: 18px;
        padding: 1rem;
    }

    .page-card .form-label {
        display: block;
        font-weight: 700;
        color: #334155;
        margin-bottom: .45rem;
        line-height: 1.2;
    }

    .page-card .form-control,
    .page-card .form-select,
    .page-card input[type="text"],
    .page-card input[type="tel"],
    .page-card input[type="number"],
    .page-card input[type="date"],
    .page-card input[type="datetime-local"],
    .page-card input[type="file"],
    .page-card select,
    .page-card textarea {
        width: 100%;
        max-width: 100%;
        border-radius: 16px;
        border: 1px solid #d8e2ec;
        min-height: 48px;
        background: #fff;
        box-shadow: none;
        padding: .75rem .9rem;
        box-sizing: border-box;
    }

    .page-card textarea,
    .page-card textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    .page-card .form-control:focus,
    .page-card .form-select:focus,
    .page-card input:focus,
    .page-card select:focus,
    .page-card textarea:focus {
        border-color: #93c5fd;
        box-shadow: 0 0 0 .2rem rgba(37, 99, 235, 0.12);
        outline: none;
    }

    .field-block {
        display: flex;
        flex-direction: column;
        gap: .35rem;
    }

    .field-block .form-errors,
    .field-block .invalid-feedback,
    .field-block ul {
        margin: 0;
        padding-left: 1rem;
        color: #dc2626;
        font-size: .82rem;
    }

    .invoice-choice-row {
        display: flex;
        flex-wrap: wrap;
        gap: .85rem;
    }

    .invoice-choice-row .form-check {
        margin: 0;
        background: #fff;
        border: 1px solid #dfe9f3;
        border-radius: 14px;
        padding: .8rem 1rem;
        font-weight: 700;
        color: #334155;
        transition: .2s ease;
    }

    .invoice-choice-row .form-check:hover {
        border-color: #93c5fd;
        background: #f8fbff;
    }

    .invoice-choice-row .form-check-input {
        margin-top: .15rem;
        margin-right: .55rem;
    }

    .invoice-choice-row .form-check-label {
        font-weight: 700;
        color: #334155;
    }

    .price-box {
        background: linear-gradient(135deg, #0d6efd 0%, #2563eb 100%);
        color: #fff;
        border-radius: 20px;
        padding: 1rem 1.1rem;
    }

    .price-line {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
        font-size: .95rem;
    }

    .price-line + .price-line {
        margin-top: .65rem;
    }

    .price-total {
        margin-top: .9rem;
        padding-top: .9rem;
        border-top: 1px solid rgba(255,255,255,.22);
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
        font-size: 1.05rem;
        font-weight: 800;
    }

    .side-note {
        background: #f8fbff;
        border: 1px solid #dfe9f3;
        border-radius: 18px;
        padding: 1rem;
        color: #64748b;
        font-size: .9rem;
    }

    .form-actions {
        border-top: 1px solid #e8eef5;
        margin-top: 1.5rem;
        padding-top: 1.25rem;
    }

    .form-actions .btn {
        border-radius: 14px;
        font-weight: 700;
        padding: .72rem 1.05rem;
    }

    .agree-box .form-check {
        margin-bottom: 0;
    }

    .agree-box .form-check-label {
        color: #334155;
        font-weight: 600;
    }

    @media (max-width: 991px) {
        .page-card {
            padding: 1rem;
        }
    }
</style>

<div class="page-shell">
    <div class="page-hero">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <div class="page-hero-title">Potwierdzenie rezerwacji</div>
                <div class="page-hero-subtitle">
                    Krok 2/2 — sprawdź wybrany termin, uzupełnij dane i zatwierdź rezerwację.
                </div>
            </div>

            <a href="{{ path('app_car_details', {'id': car.id}) }}" class="btn btn-light fw-semibold">
                ← Wróć do auta
            </a>
        </div>
    </div>

    <div class="page-card">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="summary-card mb-4">
                    <div class="section-title">Wybrane auto</div>
                    <div class="section-subtitle">
                        Upewnij się, że dane pojazdu i termin są poprawne.
                    </div>

                    <div class="car-box">
                        <div class="car-name">{{ car.brand }} {{ car.model }} ({{ car.year }})</div>
                        <div class="car-meta">Numer rejestracyjny: {{ car.registrationNumber }}</div>

                        <div class="badge-row">
                            <span class="soft-badge">📆 {{ startDate }} → {{ endDate }}</span>
                            <span class="soft-badge">🕒 {{ days }} dób</span>
                            <span class="soft-badge green-badge">💰 {{ total|number_format(2, ',', ' ') }} zł</span>
                        </div>
                    </div>
                </div>

                <div class="summary-card">
                    <div class="section-title">Dane rezerwacji</div>
                    <div class="section-subtitle">
                        Uzupełnij kontakt, miejsce odbioru i opcjonalne dane do faktury.
                    </div>

                    {{ form_start(form) }}
                        <input type="hidden" name="start" value="{{ startDate }}">
                        <input type="hidden" name="end" value="{{ endDate }}">
                        <input type="hidden" name="reserve_token" value="{{ csrf_token('reserve_confirm_' ~ car.id) }}">

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="field-block">
                                    {{ form_label(form.phoneNumber, 'Telefon') }}
                                    {{ form_widget(form.phoneNumber, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.phoneNumber) }}
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="field-block">
                                    {{ form_label(form.rentalLocation, 'Miejsce odbioru') }}
                                    {{ form_widget(form.rentalLocation, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.rentalLocation) }}
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="field-block">
                                    {{ form_label(form.comment, 'Uwagi dla właściciela') }}
                                    {{ form_widget(form.comment, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.comment) }}
                                </div>
                            </div>
                        </div>

                        <div class="form-section">
                            <div class="invoice-box">
                                <div class="section-title mb-2">Faktura</div>
                                <div class="section-subtitle mb-3">
                                    Wybierz, czy rezerwacja ma być z fakturą czy bez faktury.
                                </div>

                                <div class="invoice-choice-row mb-3">
                                    {% for choice in form.wantsInvoice %}
                                        <label class="form-check invoice-choice-card">
                                            {{ form_widget(choice, {'attr': {'class': 'form-check-input'}}) }}
                                            <span class="form-check-label">
                                                {{ choice.vars.value in ['1', 'true'] ? 'Z fakturą' : 'Bez faktury' }}
                                            </span>
                                        </label>
                                    {% endfor %}
                                </div>
                                {{ form_errors(form.wantsInvoice) }}

                                <div id="invoice-fields" class="mt-3">
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <div class="field-block">
                                                {{ form_label(form.invoiceName, 'Nabywca / nazwa firmy') }}
                                                {{ form_widget(form.invoiceName, {'attr': {'class': 'form-control'}}) }}
                                                {{ form_errors(form.invoiceName) }}
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="field-block">
                                                {{ form_label(form.invoiceStreet, 'Ulica i numer') }}
                                                {{ form_widget(form.invoiceStreet, {'attr': {'class': 'form-control', 'placeholder': 'Np. Kwiatowa 12/4'}}) }}
                                                {{ form_errors(form.invoiceStreet) }}
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="field-block">
                                                {{ form_label(form.invoicePostalCode, 'Kod pocztowy') }}
                                                {{ form_widget(form.invoicePostalCode, {'attr': {'class': 'form-control', 'placeholder': '00-000'}}) }}
                                                {{ form_errors(form.invoicePostalCode) }}
                                            </div>
                                        </div>

                                        <div class="col-md-8">
                                            <div class="field-block">
                                                {{ form_label(form.invoiceCity, 'Miasto') }}
                                                {{ form_widget(form.invoiceCity, {'attr': {'class': 'form-control', 'placeholder': 'Np. Warszawa'}}) }}
                                                {{ form_errors(form.invoiceCity) }}
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="field-block">
                                                {{ form_label(form.invoiceNip, 'NIP (opcjonalnie)') }}
                                                {{ form_widget(form.invoiceNip, {'attr': {'class': 'form-control', 'placeholder': 'Np. 1234567890'}}) }}
                                                {{ form_errors(form.invoiceNip) }}
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="text-muted small">
                                                Adres nabywcy to adres zamieszkania albo siedziby firmy. Nie wpisuj tutaj adresu e-mail.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-section">
                            <div class="agree-box">
                                <div class="section-title mb-2">Potwierdzenie</div>
                                <div class="section-subtitle mb-3">
                                    Aby przejść dalej, zaakceptuj warunki rezerwacji.
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="agreeRules" required>
                                    <label class="form-check-label" for="agreeRules">
                                        Potwierdzam poprawność danych rezerwacji i akceptuję regulamin najmu.
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="form-actions d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <div class="text-muted small">
                                Po zatwierdzeniu rezerwacja zostanie przesłana do właściciela pojazdu.
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-success">✅ Złóż rezerwację</button>
                                <a class="btn btn-outline-secondary" href="{{ path('app_car_details', {'id': car.id}) }}">
                                    ⬅ Wróć
                                </a>
                            </div>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>

            <div class="col-lg-4">
                <div class="d-flex flex-column gap-4">
                    <div class="summary-card">
                        <div class="section-title">Podsumowanie kosztów</div>
                        <div class="section-subtitle">
                            Szacunkowy koszt na podstawie wybranego terminu.
                        </div>

                        <div class="price-box">
                            <div class="price-line">
                                <span>Stawka za dobę</span>
                                <strong>{{ car.pricePerDay|number_format(2, ',', ' ') }} zł</strong>
                            </div>

                            <div class="price-line">
                                <span>Liczba dób</span>
                                <strong>{{ days }}</strong>
                            </div>

                            <div class="price-total">
                                <span>Łącznie</span>
                                <span>{{ total|number_format(2, ',', ' ') }} zł</span>
                            </div>
                        </div>
                    </div>

                    <div class="summary-card">
                        <div class="section-title">Informacja</div>
                        <div class="side-note">
                            Po złożeniu rezerwacji właściciel pojazdu otrzyma zgłoszenie. O zmianie statusu zostaniesz poinformowany w systemie.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleInvoice() {
        const wrap = document.getElementById('invoice-fields');
        const checked = document.querySelector('input[name$="[wantsInvoice]"]:checked');
        const wants = checked && (checked.value === "1" || checked.value === "true");

        if (wrap) {
            wrap.style.display = wants ? 'block' : 'none';
        }
    }

    function updateInvoiceLabels() {
        document.querySelectorAll('input[name$="[wantsInvoice]"]').forEach((input) => {
            const label = input.closest('.form-check');
            if (!label) return;

            const textNode = label.querySelector('.form-check-label');
            if (!textNode) return;

            if (input.value === '1' || input.value === 'true') {
                textNode.textContent = 'Z fakturą';
            } else {
                textNode.textContent = 'Bez faktury';
            }
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        updateInvoiceLabels();
        toggleInvoice();

        document.querySelectorAll('input[name$="[wantsInvoice]"]').forEach(el => {
            el.addEventListener('change', toggleInvoice);
        });
    });
</script>
{% endblock %}  